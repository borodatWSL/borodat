---
import "../styles/global.css";

const { title, description, pubDate } = Astro.props as {
  title: string;
  description?: string;
  pubDate?: Date;
};

const formattedDate = pubDate
  ? new Date(pubDate).toLocaleDateString("ru-RU", {
      day: "2-digit",
      month: "long",
      year: "numeric",
    })
  : "";
---

<main class="relative min-h-screen bg-black text-gray-200 selection:bg-emerald-500/30">
  
  <header class="fixed top-0 z-50 w-full border-b border-gray-800/80 bg-black/60 backdrop-blur-md">
    <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
      <a href="/blog" class="group flex items-center font-bold text-white tracking-tight transition-colors hover:text-emerald-400">
        <span class="mr-2 text-xl transition-transform group-hover:-translate-x-1">←</span>
        <span class="text-xl">Borodat</span> 
        <span class="hidden text-sm text-gray-400 sm:inline ml-2">| Все кейсы</span>
      </a>
      
      <div class="flex items-center gap-4 md:gap-6">
        <a href="https://www.youtube.com/@Borodatt" target="_blank" class="flex text-gray-400 hover:text-[#FF0000] hover:scale-110 transition-all duration-300" aria-label="YouTube">
          <svg class="h-12 w-12" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M19.812 5.418c.861.23 1.538.907 1.768 1.768C21.998 8.746 22 12 22 12s0 3.255-.418 4.814a2.504 2.504 0 0 1-1.768 1.768c-1.56.419-7.814.419-7.814.419s-6.255 0-7.814-.419a2.505 2.505 0 0 1-1.768-1.768C2 15.255 2 12 2 12s0-3.255.417-4.814a2.507 2.507 0 0 1 1.769-1.768C5.744 5 11.998 5 11.998 5s6.255 0 7.814.418ZM15.194 12 10 15V9l5.194 3Z" clip-rule="evenodd"/></svg>
        </a>
        <a 
          href="https://t.me/neyroutine_bot?start=site" 
          target="_blank" 
          class="rounded-lg bg-emerald-500/10 px-4 py-2 text-sm font-bold text-emerald-400 border border-emerald-500/20 hover:bg-emerald-500 hover:text-black transition-all duration-300 shadow-[0_0_15px_rgba(16,185,129,0.1)] hover:shadow-[0_0_20px_rgba(16,185,129,0.4)]"
        >
          Аудит процессов
        </a>
      </div>
    </div>
  </header>

  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(16,185,129,0.1),transparent_80%),radial-gradient(circle_at_bottom,_rgba(56,189,248,0.05),transparent_80%)]" />
    <div class="absolute top-0 h-[600px] w-full bg-[linear-gradient(to_right,rgba(31,41,55,0.3)_1px,transparent_1px),linear-gradient(to_bottom,rgba(31,41,55,0.3)_1px,transparent_1px)] bg-[size:60px_60px] opacity-20 [mask-image:linear-gradient(to_bottom,black,transparent)]" />
  </div>

  <div class="mx-auto max-w-3xl px-4 pt-32 pb-20 sm:px-6 lg:px-8">
    
    <header class="mb-12 sm:mb-16 border-b border-gray-800 pb-10">
      <div class="mb-6 flex items-center gap-4">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-500">
          Разбор кейса
        </p>
        {formattedDate && (
          <time class="font-mono text-sm text-gray-500">
            {formattedDate}
          </time>
        )}
      </div>
      
      <h1 class="text-balance text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl mb-6 leading-tight">
        {title}
      </h1>

      {description && (
        <p class="text-lg text-gray-400 sm:text-xl leading-relaxed">
          {description}
        </p>
      )}
    </header>

    <article class="prose prose-invert prose-lg max-w-none prose-headings:text-white prose-a:text-emerald-400 hover:prose-a:text-emerald-300 prose-strong:text-white prose-strong:font-bold prose-img:rounded-2xl prose-img:border prose-img:border-gray-800">
      <slot />
    </article>

    <section class="mt-20 rounded-3xl border border-gray-800 bg-gradient-to-br from-gray-900/80 to-black p-8 sm:p-12 text-center relative overflow-hidden group">
      <div class="absolute inset-0 bg-emerald-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
      
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4 relative z-10">
        Хотите внедрить такую же архитектуру в свой бизнес?
      </h2>
      <p class="text-lg text-gray-400 mb-8 max-w-xl mx-auto relative z-10">
        Напишите моему боту. Он задаст 3 коротких вопроса, после чего я лично проанализирую вашу задачу и предложу план автоматизации.
      </p>
      
      <a 
        href="https://t.me/neyroutine_bot?start=site" 
        target="_blank" 
        rel="noreferrer" 
        class="inline-flex items-center rounded-xl bg-emerald-500 px-8 py-4 text-lg font-bold text-black hover:bg-emerald-400 shadow-[0_0_25px_rgba(16,185,129,0.4)] hover:shadow-[0_0_35px_rgba(16,185,129,0.6)] transition-all duration-300 hover:-translate-y-1 relative z-10"
      >
        Пройти аудит процессов
        <span class="ml-2 text-xl">→</span>
      </a>
    </section>
    
  </div>
</main>